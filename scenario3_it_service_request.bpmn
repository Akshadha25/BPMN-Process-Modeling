<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_ITServiceRequest"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ITServiceRequest" name="IT Service Request Handling" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Employee reports
IT problem"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Submit" name="Submit IT support
request"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Register" name="Register the
request"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CheckSeverity" name="Check severity
of problem"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Severity" name="Severity
level?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_AssignSupport" name="Assign to support
technician"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AssignSenior" name="Assign to senior
technician"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Investigate" name="Investigate the
problem"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Resolvable" name="Resolvable
internally?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Fix" name="Fix the
problem"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Escalate" name="Escalate to external
service provider"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_UpdateStatus" name="Update request
status"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_NotifyEmployee" name="Notify employee
of resolution"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_1" name="Process ends"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submit" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Register" targetRef="Task_CheckSeverity" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckSeverity" targetRef="GW_Severity" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="GW_Severity" targetRef="Task_AssignSupport" name="Low" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="GW_Severity" targetRef="Task_AssignSenior" name="High" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AssignSupport" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_AssignSenior" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Investigate" targetRef="GW_Resolvable" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="GW_Resolvable" targetRef="Task_Fix" name="Yes - can resolve" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="GW_Resolvable" targetRef="Task_Escalate" name="No - cannot resolve" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Fix" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Escalate" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_UpdateStatus" targetRef="Task_NotifyEmployee" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_NotifyEmployee" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ITServiceRequest">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="152" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit"><dc:Bounds x="240" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register"><dc:Bounds x="390" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSeverity_di" bpmnElement="Task_CheckSeverity"><dc:Bounds x="540" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Severity_di" bpmnElement="GW_Severity"><dc:Bounds x="690" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignSupport_di" bpmnElement="Task_AssignSupport"><dc:Bounds x="790" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignSenior_di" bpmnElement="Task_AssignSenior"><dc:Bounds x="790" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Investigate_di" bpmnElement="Task_Investigate"><dc:Bounds x="940" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Resolvable_di" bpmnElement="GW_Resolvable"><dc:Bounds x="1090" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fix_di" bpmnElement="Task_Fix"><dc:Bounds x="1190" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate"><dc:Bounds x="1190" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateStatus_di" bpmnElement="Task_UpdateStatus"><dc:Bounds x="1340" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyEmployee_di" bpmnElement="Task_NotifyEmployee"><dc:Bounds x="1490" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="1640" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="250.0" /><di:waypoint x="240" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="250.0" /><di:waypoint x="390" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="490" y="250.0" /><di:waypoint x="540" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="640" y="250.0" /><di:waypoint x="690" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="740" y="250.0" /><di:waypoint x="765.0" y="250.0" /><di:waypoint x="765.0" y="100.0" /><di:waypoint x="790" y="100.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="740" y="250.0" /><di:waypoint x="765.0" y="250.0" /><di:waypoint x="765.0" y="400.0" /><di:waypoint x="790" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="890" y="100.0" /><di:waypoint x="915.0" y="100.0" /><di:waypoint x="915.0" y="250.0" /><di:waypoint x="940" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="890" y="400.0" /><di:waypoint x="915.0" y="400.0" /><di:waypoint x="915.0" y="250.0" /><di:waypoint x="940" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1040" y="250.0" /><di:waypoint x="1090" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1140" y="250.0" /><di:waypoint x="1165.0" y="250.0" /><di:waypoint x="1165.0" y="100.0" /><di:waypoint x="1190" y="100.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1140" y="250.0" /><di:waypoint x="1165.0" y="250.0" /><di:waypoint x="1165.0" y="400.0" /><di:waypoint x="1190" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1290" y="100.0" /><di:waypoint x="1315.0" y="100.0" /><di:waypoint x="1315.0" y="250.0" /><di:waypoint x="1340" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1290" y="400.0" /><di:waypoint x="1315.0" y="400.0" /><di:waypoint x="1315.0" y="250.0" /><di:waypoint x="1340" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1440" y="250.0" /><di:waypoint x="1490" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1590" y="250.0" /><di:waypoint x="1640" y="250.0" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
