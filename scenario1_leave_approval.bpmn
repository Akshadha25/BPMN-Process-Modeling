<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_LeaveApproval"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_LeaveApproval" name="Employee Leave Approval" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Employee submits
leave request"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_CheckBalance" name="Check leave
balance"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Balance" name="Sufficient
balance?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ToManager" name="Send request to
manager for approval"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ManagerDecision" name="Manager
approves?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_UpdateBalance" name="Update employee
leave balance"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_SendApproval" name="Send approval
notification"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Approved" name="Leave approved"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_SendRejection" name="Send rejection
notification"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Rejected" name="Leave rejected"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_SendInsufficient" name="Send insufficient-balance
notification"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Insufficient" name="Insufficient balance"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_CheckBalance" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckBalance" targetRef="GW_Balance" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Balance" targetRef="Task_ToManager" name="Yes" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_Balance" targetRef="Task_SendInsufficient" name="No" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ToManager" targetRef="GW_ManagerDecision" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="GW_ManagerDecision" targetRef="Task_UpdateBalance" name="Approved" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="GW_ManagerDecision" targetRef="Task_SendRejection" name="Rejected" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_UpdateBalance" targetRef="Task_SendApproval" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SendApproval" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SendRejection" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SendInsufficient" targetRef="End_Insufficient" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LeaveApproval">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="152" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckBalance_di" bpmnElement="Task_CheckBalance"><dc:Bounds x="240" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Balance_di" bpmnElement="GW_Balance"><dc:Bounds x="400" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ToManager_di" bpmnElement="Task_ToManager"><dc:Bounds x="500" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ManagerDecision_di" bpmnElement="GW_ManagerDecision"><dc:Bounds x="660" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBalance_di" bpmnElement="Task_UpdateBalance"><dc:Bounds x="760" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApproval_di" bpmnElement="Task_SendApproval"><dc:Bounds x="910" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved"><dc:Bounds x="1060" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRejection_di" bpmnElement="Task_SendRejection"><dc:Bounds x="760" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected"><dc:Bounds x="910" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendInsufficient_di" bpmnElement="Task_SendInsufficient"><dc:Bounds x="500" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Insufficient_di" bpmnElement="End_Insufficient"><dc:Bounds x="650" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="250.0" /><di:waypoint x="240" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="250.0" /><di:waypoint x="400" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="450" y="250.0" /><di:waypoint x="500" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="450" y="250.0" /><di:waypoint x="475.0" y="250.0" /><di:waypoint x="475.0" y="400.0" /><di:waypoint x="500" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="600" y="250.0" /><di:waypoint x="660" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="710" y="250.0" /><di:waypoint x="735.0" y="250.0" /><di:waypoint x="735.0" y="100.0" /><di:waypoint x="760" y="100.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="710" y="250.0" /><di:waypoint x="735.0" y="250.0" /><di:waypoint x="735.0" y="400.0" /><di:waypoint x="760" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="860" y="100.0" /><di:waypoint x="910" y="100.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1010" y="100.0" /><di:waypoint x="1060" y="100.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="860" y="400.0" /><di:waypoint x="910" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="600" y="400.0" /><di:waypoint x="650" y="400.0" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
