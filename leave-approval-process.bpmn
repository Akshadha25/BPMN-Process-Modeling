<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_LeaveApproval"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Claude" exporterVersion="1.0">
  <bpmn:process id="LeaveApprovalProcess" name="Employee Leave Request Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Leave Request Initiated"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Submit Leave Request">
  <bpmn:extensionElements>
    <zeebe:userTask />
    <zeebe:formDefinition formId="LeaveRequestForm" bindingType="latest" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_1</bpmn:incoming>
  <bpmn:outgoing>Flow_2</bpmn:outgoing>
</bpmn:userTask>
    <bpmn:serviceTask id="Task_FetchBalance" name="Fetch Leave Balance">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="fetch-leave-balance" />
    <zeebe:ioMapping>
      <zeebe:output source="=availableBalance" target="availableBalance" />
    </zeebe:ioMapping>
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_2</bpmn:incoming>
  <bpmn:outgoing>Flow_3</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_EvaluateEligibility" name="Evaluate Leave Eligibility &amp; Routing">
  <bpmn:extensionElements>
    <zeebe:calledDecision decisionId="leaveApprovalDecision" resultVariable="decision" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_3</bpmn:incoming>
  <bpmn:outgoing>Flow_4</bpmn:outgoing>
</bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Routing" name="Routing Decision?">
  <bpmn:incoming>Flow_4</bpmn:incoming>
  <bpmn:outgoing>Flow_Insufficient</bpmn:outgoing>
  <bpmn:outgoing>Flow_AutoApproved</bpmn:outgoing>
  <bpmn:outgoing>Flow_ManagerReview</bpmn:outgoing>
</bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyInsufficient" name="Notify Employee: Insufficient Balance">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="notify-insufficient-balance" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_Insufficient</bpmn:incoming>
  <bpmn:outgoing>Flow_5</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Insufficient" name="Leave Rejected - Insufficient Balance"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_ForwardHR_Auto" name="Forward to HR for Record-Keeping">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="forward-to-hr" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_AutoApproved</bpmn:incoming>
  <bpmn:outgoing>Flow_6</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateBalance_Auto" name="Update Leave Balance">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="update-leave-balance" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_6</bpmn:incoming>
  <bpmn:outgoing>Flow_7</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyApproved_Auto" name="Notify Employee: Approved">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="notify-approved" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_7</bpmn:incoming>
  <bpmn:outgoing>Flow_8</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ApprovedAuto" name="Leave Approved (Auto)"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Task_ManagerApproval" name="Manager Approval">
  <bpmn:extensionElements>
    <zeebe:userTask />
    <zeebe:formDefinition formId="ManagerApprovalForm" bindingType="latest" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_ManagerReview</bpmn:incoming>
  <bpmn:outgoing>Flow_9</bpmn:outgoing>
</bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager Decision?">
  <bpmn:incoming>Flow_9</bpmn:incoming>
  <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
  <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
</bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyRejected" name="Notify Employee: Rejected by Manager">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="notify-manager-rejection" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_Rejected</bpmn:incoming>
  <bpmn:outgoing>Flow_10</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_RejectedByManager" name="Leave Rejected by Manager"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_ForwardHR_Manager" name="Forward to HR for Record-Keeping">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="forward-to-hr" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_Approved</bpmn:incoming>
  <bpmn:outgoing>Flow_11</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateBalance_Manager" name="Update Leave Balance">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="update-leave-balance" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_11</bpmn:incoming>
  <bpmn:outgoing>Flow_12</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyApproved_Manager" name="Notify Employee: Approved">
  <bpmn:extensionElements>
    <zeebe:taskDefinition type="notify-approved" />
  </bpmn:extensionElements>
  <bpmn:incoming>Flow_12</bpmn:incoming>
  <bpmn:outgoing>Flow_13</bpmn:outgoing>
</bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ApprovedManager" name="Leave Approved (Manager)"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_FetchBalance" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_FetchBalance" targetRef="Task_EvaluateEligibility" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EvaluateEligibility" targetRef="Gateway_Routing" />
    <bpmn:sequenceFlow id="Flow_Insufficient" name="Insufficient Balance" sourceRef="Gateway_Routing" targetRef="Task_NotifyInsufficient"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "INSUFFICIENT_BALANCE"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoApproved" name="Auto Approved" sourceRef="Gateway_Routing" targetRef="Task_ForwardHR_Auto"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "AUTO_APPROVED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerReview" name="Manager Review" sourceRef="Gateway_Routing" targetRef="Task_ManagerApproval"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "MANAGER_REVIEW"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_NotifyInsufficient" targetRef="EndEvent_Insufficient" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ForwardHR_Auto" targetRef="Task_UpdateBalance_Auto" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_UpdateBalance_Auto" targetRef="Task_NotifyApproved_Auto" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NotifyApproved_Auto" targetRef="EndEvent_ApprovedAuto" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ManagerApproval" targetRef="Gateway_ManagerDecision" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="Task_NotifyRejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerDecision = "REJECTED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Task_ForwardHR_Manager"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerDecision = "APPROVED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyRejected" targetRef="EndEvent_RejectedByManager" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ForwardHR_Manager" targetRef="Task_UpdateBalance_Manager" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_UpdateBalance_Manager" targetRef="Task_NotifyApproved_Manager" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_NotifyApproved_Manager" targetRef="EndEvent_ApprovedManager" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LeaveApprovalProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="152" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest" bpmndi:isExpanded="false"><dc:Bounds x="240" y="180" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FetchBalance_di" bpmnElement="Task_FetchBalance" bpmndi:isExpanded="false"><dc:Bounds x="410" y="180" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateEligibility_di" bpmnElement="Task_EvaluateEligibility" bpmndi:isExpanded="false"><dc:Bounds x="580" y="180" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Routing_di" bpmnElement="Gateway_Routing"><dc:Bounds x="770" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyInsufficient_di" bpmnElement="Task_NotifyInsufficient" bpmndi:isExpanded="false"><dc:Bounds x="880" y="60" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Insufficient_di" bpmnElement="EndEvent_Insufficient"><dc:Bounds x="1060" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardHR_Auto_di" bpmnElement="Task_ForwardHR_Auto" bpmndi:isExpanded="false"><dc:Bounds x="880" y="180" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBalance_Auto_di" bpmnElement="Task_UpdateBalance_Auto" bpmndi:isExpanded="false"><dc:Bounds x="1060" y="180" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyApproved_Auto_di" bpmnElement="Task_NotifyApproved_Auto" bpmndi:isExpanded="false"><dc:Bounds x="1240" y="180" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ApprovedAuto_di" bpmnElement="EndEvent_ApprovedAuto"><dc:Bounds x="1420" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagerApproval_di" bpmnElement="Task_ManagerApproval" bpmndi:isExpanded="false"><dc:Bounds x="880" y="380" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision"><dc:Bounds x="1060" y="395" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRejected_di" bpmnElement="Task_NotifyRejected" bpmndi:isExpanded="false"><dc:Bounds x="1160" y="260" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedByManager_di" bpmnElement="EndEvent_RejectedByManager"><dc:Bounds x="1340" y="282" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardHR_Manager_di" bpmnElement="Task_ForwardHR_Manager" bpmndi:isExpanded="false"><dc:Bounds x="1160" y="500" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBalance_Manager_di" bpmnElement="Task_UpdateBalance_Manager" bpmndi:isExpanded="false"><dc:Bounds x="1340" y="500" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyApproved_Manager_di" bpmnElement="Task_NotifyApproved_Manager" bpmndi:isExpanded="false"><dc:Bounds x="1520" y="500" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ApprovedManager_di" bpmnElement="EndEvent_ApprovedManager"><dc:Bounds x="1700" y="522" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="220.0" /><di:waypoint x="240" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="350" y="220.0" /><di:waypoint x="410" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="520" y="220.0" /><di:waypoint x="580" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="710" y="220.0" /><di:waypoint x="770" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Insufficient_di" bpmnElement="Flow_Insufficient"><di:waypoint x="820" y="220.0" /><di:waypoint x="850.0" y="220.0" /><di:waypoint x="850.0" y="100.0" /><di:waypoint x="880" y="100.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApproved_di" bpmnElement="Flow_AutoApproved"><di:waypoint x="820" y="220.0" /><di:waypoint x="880" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerReview_di" bpmnElement="Flow_ManagerReview"><di:waypoint x="820" y="220.0" /><di:waypoint x="850.0" y="220.0" /><di:waypoint x="850.0" y="420.0" /><di:waypoint x="880" y="420.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1010" y="100.0" /><di:waypoint x="1060" y="100.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1010" y="220.0" /><di:waypoint x="1060" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1190" y="220.0" /><di:waypoint x="1240" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1370" y="220.0" /><di:waypoint x="1420" y="220.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1010" y="420.0" /><di:waypoint x="1060" y="420.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected"><di:waypoint x="1110" y="420.0" /><di:waypoint x="1135.0" y="420.0" /><di:waypoint x="1135.0" y="300.0" /><di:waypoint x="1160" y="300.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved"><di:waypoint x="1110" y="420.0" /><di:waypoint x="1135.0" y="420.0" /><di:waypoint x="1135.0" y="540.0" /><di:waypoint x="1160" y="540.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1290" y="300.0" /><di:waypoint x="1340" y="300.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1290" y="540.0" /><di:waypoint x="1340" y="540.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1470" y="540.0" /><di:waypoint x="1520" y="540.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1650" y="540.0" /><di:waypoint x="1700" y="540.0" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
