{
  "components": [
    {
      "id": "Field_summary",
      "type": "text",
      "text": "## Hostel out-pass request\n\n**Student:** {{studentName}} ({{regNo}})\n\n**Hostel block:** {{hostelBlock}}\n\n**Out date:** {{outDate}}  \n**Return date:** {{returnDate}}  \n**Nights:** {{nights}}\n\n**Parent phone:** {{parentPhone}}\n\n**Purpose:** {{purpose}}"
    },
    {
      "id": "Field_approved",
      "key": "approved",
      "type": "checkbox",
      "label": "Approve this out-pass"
    },
    {
      "id": "Field_remarks",
      "key": "wardenRemarks",
      "type": "textarea",
      "label": "Warden remarks"
    }
  ],
  "type": "default",
  "id": "warden-approval-form",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "schemaVersion": 17
}
