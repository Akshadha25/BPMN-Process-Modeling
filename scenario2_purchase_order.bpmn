<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_PurchaseOrder"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_PurchaseOrder" name="Online Purchase Order Processing" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Customer
places order"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_CheckAvail" name="Check product
availability"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Available" name="Product
available?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyOOS" name="Notify customer:
out of stock"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_OOS" name="Order cancelled
(out of stock)"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_ProcessPayment" name="Process
payment"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_PaymentOK" name="Payment
successful?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyPayFail" name="Notify customer:
payment failed"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_PayFail" name="Order cancelled
(payment failed)"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_ConfirmOrder" name="Confirm order"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_PrepareShipment" name="Prepare product
for shipment"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ShipOrder" name="Ship order"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_SendShipConfirm" name="Send shipping
confirmation"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Completed" name="Order completed"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_CheckAvail" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckAvail" targetRef="GW_Available" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Available" targetRef="Task_NotifyOOS" name="No" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_Available" targetRef="Task_ProcessPayment" name="Yes" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_NotifyOOS" targetRef="End_OOS" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ProcessPayment" targetRef="GW_PaymentOK" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="GW_PaymentOK" targetRef="Task_NotifyPayFail" name="No" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="GW_PaymentOK" targetRef="Task_ConfirmOrder" name="Yes" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_NotifyPayFail" targetRef="End_PayFail" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ConfirmOrder" targetRef="Task_PrepareShipment" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ShipOrder" targetRef="Task_SendShipConfirm" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SendShipConfirm" targetRef="End_Completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_PurchaseOrder">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="152" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckAvail_di" bpmnElement="Task_CheckAvail"><dc:Bounds x="240" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Available_di" bpmnElement="GW_Available"><dc:Bounds x="400" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyOOS_di" bpmnElement="Task_NotifyOOS"><dc:Bounds x="500" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OOS_di" bpmnElement="End_OOS"><dc:Bounds x="650" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment"><dc:Bounds x="500" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PaymentOK_di" bpmnElement="GW_PaymentOK"><dc:Bounds x="660" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyPayFail_di" bpmnElement="Task_NotifyPayFail"><dc:Bounds x="760" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PayFail_di" bpmnElement="End_PayFail"><dc:Bounds x="910" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmOrder_di" bpmnElement="Task_ConfirmOrder"><dc:Bounds x="760" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareShipment_di" bpmnElement="Task_PrepareShipment"><dc:Bounds x="910" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder"><dc:Bounds x="1060" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendShipConfirm_di" bpmnElement="Task_SendShipConfirm"><dc:Bounds x="1210" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Completed_di" bpmnElement="End_Completed"><dc:Bounds x="1360" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="250.0" /><di:waypoint x="240" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="250.0" /><di:waypoint x="400" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="450" y="250.0" /><di:waypoint x="475.0" y="250.0" /><di:waypoint x="475.0" y="400.0" /><di:waypoint x="500" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="450" y="250.0" /><di:waypoint x="500" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="600" y="400.0" /><di:waypoint x="650" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="600" y="250.0" /><di:waypoint x="660" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="710" y="250.0" /><di:waypoint x="735.0" y="250.0" /><di:waypoint x="735.0" y="400.0" /><di:waypoint x="760" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="710" y="250.0" /><di:waypoint x="760" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="860" y="400.0" /><di:waypoint x="910" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="860" y="250.0" /><di:waypoint x="910" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1010" y="250.0" /><di:waypoint x="1060" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1160" y="250.0" /><di:waypoint x="1210" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1310" y="250.0" /><di:waypoint x="1360" y="250.0" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
