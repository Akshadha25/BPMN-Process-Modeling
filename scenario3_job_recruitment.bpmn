<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_JobRecruitment"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_JobRecruitment" name="Job Applicant Recruitment Process" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Candidate submits
job application"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Screen" name="Screen application vs.
eligibility criteria"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Eligible" name="Meets
eligibility?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Reject1" name="Send rejection
notification"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_Rejected1" name="Rejected -
not eligible"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Task_ScheduleTech" name="Schedule technical
interview"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_EvaluateTech" name="Technical panel evaluates
candidate performance"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_PassTech" name="Passes technical
interview?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Reject2" name="Send rejection
notification"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_Rejected2" name="Rejected -
failed technical round"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Task_ScheduleHR" name="Schedule HR /
managerial round"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ConductHR" name="Conduct HR /
managerial round"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_SelectedHR" name="Selected in
HR round?"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Reject3" name="Send rejection
notification"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_Rejected3" name="Rejected -
HR round"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_GenerateOffer" name="Generate
offer letter"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendOffer" name="Send offer letter
to candidate"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_OfferSent" name="Offer letter sent"><bpmn:incoming>Flow_17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Screen" targetRef="GW_Eligible" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Eligible" targetRef="Task_Reject1" name="No" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_Eligible" targetRef="Task_ScheduleTech" name="Yes" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Reject1" targetRef="End_Rejected1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ScheduleTech" targetRef="Task_EvaluateTech" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_EvaluateTech" targetRef="GW_PassTech" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="GW_PassTech" targetRef="Task_Reject2" name="No" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="GW_PassTech" targetRef="Task_ScheduleHR" name="Yes" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Reject2" targetRef="End_Rejected2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ScheduleHR" targetRef="Task_ConductHR" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ConductHR" targetRef="GW_SelectedHR" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="GW_SelectedHR" targetRef="Task_Reject3" name="No" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="GW_SelectedHR" targetRef="Task_GenerateOffer" name="Yes" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Reject3" targetRef="End_Rejected3" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_GenerateOffer" targetRef="Task_SendOffer" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SendOffer" targetRef="End_OfferSent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_JobRecruitment">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="152" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Screen_di" bpmnElement="Task_Screen"><dc:Bounds x="240" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Eligible_di" bpmnElement="GW_Eligible"><dc:Bounds x="400" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject1_di" bpmnElement="Task_Reject1"><dc:Bounds x="500" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected1_di" bpmnElement="End_Rejected1"><dc:Bounds x="650" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScheduleTech_di" bpmnElement="Task_ScheduleTech"><dc:Bounds x="500" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateTech_di" bpmnElement="Task_EvaluateTech"><dc:Bounds x="650" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PassTech_di" bpmnElement="GW_PassTech"><dc:Bounds x="810" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject2_di" bpmnElement="Task_Reject2"><dc:Bounds x="910" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected2_di" bpmnElement="End_Rejected2"><dc:Bounds x="1060" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScheduleHR_di" bpmnElement="Task_ScheduleHR"><dc:Bounds x="910" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConductHR_di" bpmnElement="Task_ConductHR"><dc:Bounds x="1060" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_SelectedHR_di" bpmnElement="GW_SelectedHR"><dc:Bounds x="1220" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject3_di" bpmnElement="Task_Reject3"><dc:Bounds x="1320" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected3_di" bpmnElement="End_Rejected3"><dc:Bounds x="1470" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateOffer_di" bpmnElement="Task_GenerateOffer"><dc:Bounds x="1320" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendOffer_di" bpmnElement="Task_SendOffer"><dc:Bounds x="1470" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OfferSent_di" bpmnElement="End_OfferSent"><dc:Bounds x="1620" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="250.0" /><di:waypoint x="240" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="250.0" /><di:waypoint x="400" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="450" y="250.0" /><di:waypoint x="475.0" y="250.0" /><di:waypoint x="475.0" y="400.0" /><di:waypoint x="500" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="450" y="250.0" /><di:waypoint x="500" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="600" y="400.0" /><di:waypoint x="650" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="600" y="250.0" /><di:waypoint x="650" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="750" y="250.0" /><di:waypoint x="810" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="860" y="250.0" /><di:waypoint x="885.0" y="250.0" /><di:waypoint x="885.0" y="400.0" /><di:waypoint x="910" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="860" y="250.0" /><di:waypoint x="910" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1010" y="400.0" /><di:waypoint x="1060" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1010" y="250.0" /><di:waypoint x="1060" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1160" y="250.0" /><di:waypoint x="1220" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1270" y="250.0" /><di:waypoint x="1295.0" y="250.0" /><di:waypoint x="1295.0" y="400.0" /><di:waypoint x="1320" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1270" y="250.0" /><di:waypoint x="1320" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1420" y="400.0" /><di:waypoint x="1470" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="1420" y="250.0" /><di:waypoint x="1470" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17"><di:waypoint x="1570" y="250.0" /><di:waypoint x="1620" y="250.0" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
