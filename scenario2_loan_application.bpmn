<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Process_LoanApplication"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_LoanApplication" name="Loan Application Processing" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Customer submits
loan application"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_VerifyDocs" name="Verify documents &amp;
credit score"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_DocsValid" name="Documents
valid?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RejectInvalidDocs" name="Reject application &amp;
notify customer"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_RejectedInvalid" name="Rejected -
invalid documents"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_CheckEligibility" name="Check eligibility
(credit score, income)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Eligible" name="Applicant
eligible?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RejectNotEligible" name="Send rejection
notification"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_RejectedNotEligible" name="Rejected -
not eligible"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_ForwardToOfficer" name="Forward to loan
officer for approval"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_OfficerApproves" name="Loan officer
approves?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RejectOfficer" name="Send rejection
notification"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_RejectedOfficer" name="Rejected -
loan officer"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_DisburseLoan" name="Disburse the
loan amount"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendApproval" name="Send approval
notification"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_Approved" name="Loan approved"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_VerifyDocs" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_VerifyDocs" targetRef="GW_DocsValid" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_DocsValid" targetRef="Task_RejectInvalidDocs" name="Invalid/Incomplete" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_DocsValid" targetRef="Task_CheckEligibility" name="Valid" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RejectInvalidDocs" targetRef="End_RejectedInvalid" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CheckEligibility" targetRef="GW_Eligible" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="GW_Eligible" targetRef="Task_RejectNotEligible" name="No" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="GW_Eligible" targetRef="Task_ForwardToOfficer" name="Yes" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_RejectNotEligible" targetRef="End_RejectedNotEligible" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ForwardToOfficer" targetRef="GW_OfficerApproves" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="GW_OfficerApproves" targetRef="Task_RejectOfficer" name="No" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="GW_OfficerApproves" targetRef="Task_DisburseLoan" name="Yes" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RejectOfficer" targetRef="End_RejectedOfficer" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_DisburseLoan" targetRef="Task_SendApproval" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SendApproval" targetRef="End_Approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LoanApplication">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="152" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyDocs_di" bpmnElement="Task_VerifyDocs"><dc:Bounds x="240" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_DocsValid_di" bpmnElement="GW_DocsValid"><dc:Bounds x="400" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectInvalidDocs_di" bpmnElement="Task_RejectInvalidDocs"><dc:Bounds x="500" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectedInvalid_di" bpmnElement="End_RejectedInvalid"><dc:Bounds x="650" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckEligibility_di" bpmnElement="Task_CheckEligibility"><dc:Bounds x="500" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Eligible_di" bpmnElement="GW_Eligible"><dc:Bounds x="660" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectNotEligible_di" bpmnElement="Task_RejectNotEligible"><dc:Bounds x="760" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectedNotEligible_di" bpmnElement="End_RejectedNotEligible"><dc:Bounds x="910" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardToOfficer_di" bpmnElement="Task_ForwardToOfficer"><dc:Bounds x="760" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_OfficerApproves_di" bpmnElement="GW_OfficerApproves"><dc:Bounds x="920" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectOfficer_di" bpmnElement="Task_RejectOfficer"><dc:Bounds x="1020" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectedOfficer_di" bpmnElement="End_RejectedOfficer"><dc:Bounds x="1170" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DisburseLoan_di" bpmnElement="Task_DisburseLoan"><dc:Bounds x="1020" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApproval_di" bpmnElement="Task_SendApproval"><dc:Bounds x="1170" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved"><dc:Bounds x="1320" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="250.0" /><di:waypoint x="240" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="250.0" /><di:waypoint x="400" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="450" y="250.0" /><di:waypoint x="475.0" y="250.0" /><di:waypoint x="475.0" y="400.0" /><di:waypoint x="500" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="450" y="250.0" /><di:waypoint x="500" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="600" y="400.0" /><di:waypoint x="650" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="600" y="250.0" /><di:waypoint x="660" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="710" y="250.0" /><di:waypoint x="735.0" y="250.0" /><di:waypoint x="735.0" y="400.0" /><di:waypoint x="760" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="710" y="250.0" /><di:waypoint x="760" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="860" y="400.0" /><di:waypoint x="910" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="860" y="250.0" /><di:waypoint x="920" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="970" y="250.0" /><di:waypoint x="995.0" y="250.0" /><di:waypoint x="995.0" y="400.0" /><di:waypoint x="1020" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="970" y="250.0" /><di:waypoint x="1020" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1120" y="400.0" /><di:waypoint x="1170" y="400.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1120" y="250.0" /><di:waypoint x="1170" y="250.0" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1270" y="250.0" /><di:waypoint x="1320" y="250.0" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
